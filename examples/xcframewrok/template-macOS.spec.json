    "MattReach": "qianlongxu@gmail.com"
  },
  "platforms": {
    "osx": "10.11"
  },
  "source": {
    "http": "https://github.com/debugly/fsplayer/releases/download/__VERSION__/FSPlayer-macOS.zip"
